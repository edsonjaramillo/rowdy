#!/bin/sh

config=$(cat)

if [ "$*" != "-q --config -" ]; then
	printf '%s\n' "unsafe curl arguments: $*" >&2
	exit 2
fi

case "$*" in
	*"$OPENROUTER_API_KEY"*)
		printf '%s\n' "API key appeared in curl arguments" >&2
		exit 2
		;;
esac

for required in \
	"Authorization: Bearer $OPENROUTER_API_KEY" \
	'connect-timeout = "10"'
do
	case "$config" in
		*"$required"*) ;;
		*)
			printf '%s\n' "missing curl config: $required" >&2
			exit 2
			;;
	esac
done

if [ "$ROWDY_CURL_SCENARIO" = "generate" ] || [ "$ROWDY_CURL_SCENARIO" = "stream" ]; then
	for required in \
		'request = "POST"' \
		'url = "https://openrouter.ai/api/v1/chat/completions"' \
		'Content-Type: application/json' \
		'sensitive prompt not in argv or files' \
		'deepinfra/turbo' \
		'allow_fallbacks\":false'
	do
		case "$config" in
			*"$required"*) ;;
			*)
				printf '%s\n' "missing generation curl config: $required" >&2
				exit 2
				;;
		esac
	done
	if [ "$ROWDY_CURL_SCENARIO" = "stream" ]; then
		for required in 'stream\":true' 'Accept: text/event-stream' 'no-buffer'
		do
			case "$config" in
				*"$required"*) ;;
				*)
					printf '%s\n' "missing streaming curl config: $required" >&2
					exit 2
					;;
			esac
		done
	else
		case "$config" in
			*'stream\":false'*) ;;
			*)
				printf '%s\n' "non-streaming generation enabled streaming" >&2
				exit 2
				;;
		esac
	fi
	case "$config" in
		*'max-time'*)
			printf '%s\n' "generation unexpectedly had a total timeout" >&2
			exit 2
			;;
	esac
else
	case "$config" in
		*'max-time = "30"'*) ;;
		*)
			printf '%s\n' "missing curl config: max-time" >&2
			exit 2
			;;
	esac
fi

if [ "$ROWDY_CURL_SCENARIO" = "cancel" ]; then
	printf '%s\n' "$$" > "$ROWDY_CURL_STATE"
	exec sleep 30
fi

count=0
if [ -f "$ROWDY_CURL_STATE" ]; then
	read -r count < "$ROWDY_CURL_STATE"
fi
count=$((count + 1))
printf '%s\n' "$count" > "$ROWDY_CURL_STATE"

if [ "$ROWDY_CURL_SCENARIO" = "generate" ]; then
	printf '%s\n' \
		'{"id":"gen-secure","model":"openai/gpt-4o-mini","choices":[{"text":"secure","finish_reason":"stop"}]}' \
		'__ROWDY_HTTP_STATUS__:200' \
		'__ROWDY_RETRY_AFTER__:'
	exit 0
fi

if [ "$ROWDY_CURL_SCENARIO" = "stream" ]; then
	printf '%s\n' \
		'data: {"id":"gen-secure","model":"openai/gpt-4o-mini","choices":[{"delta":{"content":"secure"},"finish_reason":"stop"}]}' \
		'' \
		'data: [DONE]' \
		'' \
		'__ROWDY_HTTP_STATUS__:200' \
		'__ROWDY_RETRY_AFTER__:'
	exit 0
fi

if [ "$ROWDY_CURL_SCENARIO" = "outcomes" ]; then
	outcome=200
	index=1
	for candidate in $ROWDY_CURL_OUTCOMES
	do
		if [ "$index" -eq "$count" ]; then
			outcome=$candidate
			break
		fi
		index=$((index + 1))
	done
	if [ "$outcome" = "transport" ]; then
		printf '%s\n' 'controlled transport failure' >&2
		exit 6
	fi
	if [ "$outcome" = "gateway" ]; then
		printf '%s\n' \
			'{"error":{"code":503,"message":"Gateway application failure"}}' \
			'__ROWDY_HTTP_STATUS__:503' \
			'__ROWDY_RETRY_AFTER__:'
		exit 0
	fi
	if [ "$outcome" != "200" ]; then
		printf '%s\n' \
			'{"temporary":true}' \
			"__ROWDY_HTTP_STATUS__:$outcome" \
			"__ROWDY_RETRY_AFTER__:$ROWDY_RETRY_AFTER"
		exit 0
	fi
fi

if [ "$ROWDY_CURL_SCENARIO" = "retry" ] && [ "$count" -lt 3 ]; then
	printf '%s\n' \
		'{"temporary":true}' \
		'__ROWDY_HTTP_STATUS__:503' \
		'__ROWDY_RETRY_AFTER__:'
	exit 0
fi

if [ "$ROWDY_CURL_SCENARIO" = "backoff" ]; then
	printf '%s\n' \
		'{"temporary":true}' \
		'__ROWDY_HTTP_STATUS__:503' \
		"__ROWDY_RETRY_AFTER__:$ROWDY_RETRY_AFTER"
	exit 0
fi

if [ "$ROWDY_CURL_SCENARIO" = "outcomes" ] && [ "$ROWDY_CURL_DISCOVERY" = "models" ]; then
	printf '%s\n' \
		'{"data":[],"links":{"next":null}}' \
		'__ROWDY_HTTP_STATUS__:200' \
		'__ROWDY_RETRY_AFTER__:'
	exit 0
fi

printf '%s\n' \
	'{"data":{"id":"openai/gpt-4o-mini","endpoints":[{"tag":"openai"}]}}' \
	'__ROWDY_HTTP_STATUS__:200' \
	'__ROWDY_RETRY_AFTER__:'
